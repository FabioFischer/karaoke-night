{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:public",
  "outputDirectory": "dist-public",
  "trailingSlash": false,
  "redirects": [{ "source": "/", "destination": "/karaoke", "permanent": false }],
  "rewrites": [{ "source": "/karaoke", "destination": "/public.html" }]
}
